{
  "name": "tevro",
  "version": "0.1.0",
  "private": true,
  "description": "Tevro MVP — 공정과 선후관계, 진행 상태를 한 화면에서 보는 도구",
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "bin": {
    "tevro": "src/cli/main.ts"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "demo": "node scripts/demo.ts",
    "admin": "node src/server/admin.ts",
    "test": "node --test --test-reporter=spec test/*.test.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
